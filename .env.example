# PostgreSQL (docker compose maps container 5432 -> host 55432)
RT_DATABASE_URL=postgresql+psycopg://rt_claude:rt_claude@127.0.0.1:55447/rt_claude

# GitHub token. Read-only scopes are enough (public_repo / read:discussion).
# If empty, the CLI falls back to `gh auth token`.
RT_GITHUB_TOKEN=

# Where third-party repositories are cloned (see AI_STORAGE_RULES.md).
RT_CLONE_ROOT=D:/Dev/Repos/_rt_mirrors

# Sync scope guards (V1 keeps first sync bounded on purpose).
RT_DISCUSSION_PAGE_SIZE=50
RT_MAX_DISCUSSIONS_PER_RUN=0
